# CamCore Listmonk deployment
# Copy to .env on Ganymede and replace every CHANGE_ME value.

LISTMONK_BIND_IP=192.168.5.101
LISTMONK_BIND_PORT=9001

LISTMONK_ADMIN_USER=camcore_admin
LISTMONK_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
LISTMONK_DB_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD
